<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CanvasX" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.CanvasX.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background, animated icon, and some options. -->
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
        <!-- Set the theme of the Activity that directly follows your splash screen. -->
        <item name="postSplashScreenTheme">@style/Theme.CanvasX</item>
    </style>
</resources>